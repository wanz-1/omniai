{
  "title": "OmniAI — Database Health",
  "uid": "omniai-db",
  "version": 1,
  "timezone": "utc",
  "editable": false,
  "panels": [
    {
      "title": "Active Connections",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 0, "w": 6, "h": 6},
      "targets": [{"expr": "db_connections_active", "legendFormat": "active"}],
      "fieldConfig": {
        "defaults": {"unit": "conn", "custom": {"showPoints": "never"}}
      }
    },
    {
      "title": "Query Latency P50/P95/P99",
      "type": "timeseries",
      "gridPos": {"x": 6, "y": 0, "w": 6, "h": 6},
      "targets": [
        {"expr": "histogram_quantile(0.5, rate(db_query_duration_seconds_bucket[5m]))", "legendFormat": "P50"},
        {"expr": "histogram_quantile(0.95, rate(db_query_duration_seconds_bucket[5m]))", "legendFormat": "P95"},
        {"expr": "histogram_quantile(0.99, rate(db_query_duration_seconds_bucket[5m]))", "legendFormat": "P99"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "s", "custom": {"showPoints": "never"}}
      }
    },
    {
      "title": "Slow Queries",
      "type": "timeseries",
      "gridPos": {"x": 0, "y": 7, "w": 6, "h": 6},
      "targets": [
        {"expr": "histogram_quantile(0.99, rate(db_query_duration_seconds_bucket[5m])) > 1", "legendFormat": "slow queries"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "q/s", "custom": {"showPoints": "never"}}
      }
    },
    {
      "title": "Database Errors",
      "type": "timeseries",
      "gridPos": {"x": 6, "y": 7, "w": 6, "h": 6},
      "targets": [
        {"expr": "rate(db_errors_total[5m])", "legendFormat": "{{query_type}}"}
      ],
      "fieldConfig": {
        "defaults": {"unit": "err/s", "custom": {"showPoints": "never"}}
      }
    }
  ],
  "tags": ["omniai", "database"],
  "schemaVersion": 39
}
