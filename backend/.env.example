# OmniAI API — environment configuration template.
# Copy to .env and fill in real values. All values shown are safe dev defaults.

# ── App ────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
APP_VERSION=6.0.0
DEFAULT_AI_PROVIDER=openai
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]

# ── Database ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://omniai:omniai@localhost:5432/omniai
DATABASE_URL_SYNC=postgresql://omniai:omniai@localhost:5432/omniai
REDIS_URL=redis://localhost:6379/0

# ── Auth / JWT ─────────────────────────────────────────────────────────────
# REQUIRED in production: use a long random value (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me-in-production
JWT_KEY_VERSION=1
JWT_SECRET_PREVIOUS=[]
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
REFRESH_TOKEN_ROTATION=true
TOKEN_BLACKLIST_ENABLED=true

# ── OAuth (optional) ───────────────────────────────────────────────────────
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_APPLE_CLIENT_ID=
OAUTH_APPLE_CLIENT_SECRET=

# ── Object storage (optional) ──────────────────────────────────────────────
S3_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=
S3_REGION=

# ── Payments (optional) ────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── AI providers — at least one is required for AI features ────────────────
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_GEMINI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
VLLM_BASE_URL=

# ── Vector store / queues ──────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# ── Rate limiting ──────────────────────────────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Security / MFA ─────────────────────────────────────────────────────────
MFA_ENABLED=false
MFA_ISSUER_NAME=OmniAI
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15
BRUTE_FORCE_RATE_LIMIT=10
BRUTE_FORCE_WINDOW_SECONDS=300
TRUSTED_PROXIES=["127.0.0.1"]

# ── Misc ───────────────────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=25
SENTRY_DSN=
