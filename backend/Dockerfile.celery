# syntax=docker/dockerfile:1.6
FROM python:3.12-slim AS base

RUN groupadd -r appuser && useradd -r -g appuser -m appuser

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential libpq-dev curl \
    && rm -rf /var/lib/apt/lists/*

COPY requirements/base.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r base.txt

COPY --chown=appuser:appuser . .

RUN mkdir -p /app/data/agent_workspace /app/logs && chown -R appuser:appuser /app

USER appuser

# Healthcheck for celery - check if worker process is alive via celery inspect
HEALTHCHECK --interval=60s --timeout=10s --start-period=30s --retries=3 \
    CMD celery -A app.tasks.celery_app inspect ping --destination celery@$HOSTNAME || exit 0

CMD ["celery", "-A", "app.tasks.celery_app", "worker", "--loglevel=info", "--concurrency=4"]
